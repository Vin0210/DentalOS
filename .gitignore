# ── Dependencies ───────────────────────────────────────────
node_modules/
vendor/

# ── Build output ─────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Environment & secrets (NEVER commit) ────────────────────
.env
.env.backup
.env.*.local
storage/*.key
storage/logs/*
!storage/logs/.gitignore

# ── PHP / Laravel ────────────────────────────────────────────
.phpunit.result.cache
.phpunit.cache/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor & OS ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo